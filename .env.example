# CoStock 환경변수 템플릿
# 실제 값은 절대 이 파일에 입력하지 마세요.
# 복사: cp .env.example .env  →  .env에 실제 값 입력
# .env는 git에 절대 커밋 금지 (.gitignore 확인 필수)

# ─────────────────────────────────────────────
# API 서버 (apps/api)
# ─────────────────────────────────────────────
NODE_ENV=development
PORT=3000
HOST=0.0.0.0
LOG_LEVEL=info

# JWT — 최소 32자 랜덤 문자열 필수
# 생성: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# PostgreSQL (TimescaleDB)
DATABASE_URL=postgresql://costock:costock_dev_pw@localhost:5432/costock_dev

# Redis
REDIS_URL=redis://localhost:6379

# Kafka
KAFKA_BROKERS=localhost:9092

# CORS 허용 오리진 (쉼표 구분)
ALLOWED_ORIGINS=http://localhost:3001

# ─────────────────────────────────────────────
# 수집 서비스 (apps/collector)
# ─────────────────────────────────────────────

# 업비트 수집 마켓 목록
UPBIT_MARKETS=KRW-BTC,KRW-ETH,KRW-XRP,KRW-SOL,KRW-DOGE

# 빗썸 API (공개 WebSocket은 키 불필요, 비공개 API용)
# BITHUMB_API_KEY=
# BITHUMB_SECRET_KEY=

# 한국투자증권 Open API (주식 현재가 / 차트 / 투자자 동향)
# 발급: https://apiportal.koreainvestment.com
# KIS_APP_KEY, KIS_APP_SECRET는 기존 변수명 유지 (레거시 호환)
# KIS_APP_KEY=
# KIS_APP_SECRET=
# KIS_ACCOUNT_NO=
# 한국투자증권 hantoo 변수명 (apps/api에서 사용)
# HANTOO_APP_KEY=
# HANTOO_APP_SECRET=

# KRX 데이터 수집 (공개 API)
# KRX_API_KEY=

# ─────────────────────────────────────────────
# 인프라 / AWS (프로덕션 전용)
# ─────────────────────────────────────────────

# AWS 자격증명은 절대 여기에 입력 금지
# IAM Role (ECS Task Role)로만 관리
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# Sentry (에러 모니터링)
# SENTRY_DSN=

# Datadog (APM)
# DD_API_KEY=
# DD_SERVICE=costock-api
# DD_ENV=production

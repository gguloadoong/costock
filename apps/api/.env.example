# CoStock API 서버 환경변수 예시
# 실제 값으로 채워서 .env 파일로 저장하세요

# 서버 포트
PORT=3101
HOST=0.0.0.0

# 허용 오리진 (쉼표 구분)
ALLOWED_ORIGINS=http://localhost:3100

# JWT 시크릿 (32자 이상 랜덤 문자열)
JWT_SECRET=your-super-secret-jwt-key-change-this

# 데이터베이스 (PostgreSQL + TimescaleDB)
DATABASE_URL=postgresql://user:password@localhost:5432/costock

# Redis
REDIS_URL=redis://localhost:6379

# 로그 레벨
LOG_LEVEL=info
NODE_ENV=development
